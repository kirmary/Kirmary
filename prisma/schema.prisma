// قاعدة البيانات: RFQ + Messages + Products

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// مراحل متابعة طلب عرض السعر
enum RfqStatus {
  NEW
  IN_REVIEW
  QUOTED
  WON
  LOST
}

enum MessageStatus {
  NEW
  READ
  REPLIED
}

model Rfq {
  id                    String    @id @default(cuid())
  reference             String    @unique
  fullName              String
  workEmail             String
  phone                 String
  companyName           String?
  projectName           String
  projectLocation       String?
  products              String
  quantities            String?
  technicalRequirements String?
  locale                String    @default("en")
  status                RfqStatus @default(NEW)
  note                  String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([status, createdAt])
}

model Message {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  locale    String        @default("en")
  status    MessageStatus @default(NEW)
  createdAt DateTime      @default(now())

  @@index([status, createdAt])
}

// منتجات KIRMARY
model Product {
  id              String   @id @default(cuid())
  slug            String   @unique
  number          String
  name            String
  nameAr          String
  description     String
  descriptionAr   String
  image           String?
  tags            String[] @default([])
  category        String?
  brand           String?
  featured        Boolean  @default(false)
  visible         Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([visible, sortOrder])
  @@index([category])
  @@index([brand])
}

model Project {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  nameAr        String
  image         String
  subtitle      String?
  subtitleAr    String?
  description   String?
  descriptionAr String?
  category      String?
  visible       Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([visible, sortOrder])
  @@index([category])
}
