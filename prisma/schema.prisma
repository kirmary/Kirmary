generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Rfq {
  id                    String    @id @default(cuid())
  reference             String    @unique
  fullName              String
  workEmail             String
  phone                 String
  companyName           String?
  projectName           String
  projectLocation       String?
  products              String
  quantities            String?
  technicalRequirements String?
  locale                String    @default("en")
  status                RfqStatus @default(NEW)
  note                  String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([status, createdAt])
}

model Message {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  locale    String        @default("en")
  status    MessageStatus @default(NEW)
  createdAt DateTime      @default(now())

  @@index([status, createdAt])
}

model Product {
  id            String   @id @default(cuid())
  slug          String   @unique
  number        String
  name          String
  nameAr        String
  description   String
  descriptionAr String
  image         String?
  coverImage    String?
  subtitle      String?
  subtitleAr    String?
  contentManaged Boolean @default(false)
  legacySlug    String?
  features      ProductFeature[]
  documents     ProductDocument[]
  aliases       ProductAlias[]
  tags          String[] @default([])
  category      String?
  brand         String?
  featured      Boolean  @default(false)
  visible       Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([visible, sortOrder])
  @@index([category])
  @@index([brand])
}

model ProductAlias {
  slug String @id
  productId String
  product Product @relation(fields: [productId], references: [id])
}

model ProductFeature {
  id String @id @default(cuid())
  productId String
  product Product @relation(fields: [productId], references: [id])
  title String
  titleAr String @default("")
  description String @default("")
  descriptionAr String @default("")
  documentUrl String?
  linkLabel String?
  visible Boolean @default(true)
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  @@index([productId, sortOrder, createdAt])
}

model ProductDocument {
  id String @id @default(cuid())
  productId String
  product Product @relation(fields: [productId], references: [id])
  title String
  titleAr String @default("")
  originalFileName String
  documentType String
  fileUrl String
  visible Boolean @default(true)
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  @@index([productId, sortOrder, createdAt])
}

model Project {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  nameAr        String
  image         String
  subtitle      String?
  subtitleAr    String?
  description   String?
  descriptionAr String?
  category      String?
  visible       Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([visible, sortOrder])
  @@index([category])
}

model GalleryImage {
  id            String   @id @default(cuid())
  image         String
  title         String
  titleAr       String
  description   String?
  descriptionAr String?
  category      String?
  featured      Boolean  @default(false)
  visible       Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  section       String   @default("general")

  @@index([visible, sortOrder])
  @@index([category])
  @@index([section])
}

model GallerySection {
  id         String   @id @default(cuid())
  name       String
  nameAr     String
  slug       String   @unique
  coverImage String?
  visible    Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([visible, sortOrder])
}

enum RfqStatus {
  NEW
  IN_REVIEW
  QUOTED
  WON
  LOST
}

enum MessageStatus {
  NEW
  READ
  REPLIED
}
